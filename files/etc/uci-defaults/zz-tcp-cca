#!/bin/sh
# Run after turboacc's own uci-defaults script.
# Full Cone mode 1 is the nft_fullcone compatibility mode (not Broadcom mode 2).
uci -q set firewall.@defaults[0].fullcone='1'
uci -q set firewall.@defaults[0].fullcone6='0'
uci -q set firewall.@defaults[0].tcpcca='bbr'
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q commit firewall
exit 0
