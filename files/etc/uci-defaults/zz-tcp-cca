#!/bin/sh
# First-boot defaults for SONiC Fullcone and native OpenWrt acceleration.
uci -q set firewall.@defaults[0].fullcone='1'

# Preserve Fullcone on every masquerading zone; SONiC requires both global and zone gates.
for zone in $(uci -q show firewall | sed -n 's/^firewall\.\([^=]*\)=zone$/\1/p'); do
    if [ "$(uci -q get "firewall.$zone.masq")" = '1' ]; then
        uci -q set "firewall.$zone.fullcone"='1'
    fi
done

# Migrate the previous local key to LEDE's tcpcca key, then default to BBR.
old_cca="$(uci -q get firewall.@defaults[0].tcp_cca)"
current_cca="$(uci -q get firewall.@defaults[0].tcpcca)"
[ -n "$current_cca" ] || [ -z "$old_cca" ] || uci -q set firewall.@defaults[0].tcpcca="$old_cca"
uci -q delete firewall.@defaults[0].tcp_cca 2>/dev/null || true
[ -n "$(uci -q get firewall.@defaults[0].tcpcca)" ] || uci -q set firewall.@defaults[0].tcpcca='bbr'
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q set firewall.@defaults[0].flow_offloading_hw='0'
uci -q commit firewall

if [ -x /etc/init.d/tcp-cca ]; then
    /etc/init.d/tcp-cca enable
    /etc/init.d/tcp-cca start
fi
exit 0
