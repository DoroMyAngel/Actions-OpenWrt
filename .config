# OpenWrt official main - x86_64 / ext4
# Build both Legacy BIOS and UEFI combined disk images.

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y

CONFIG_TARGET_ROOTFS_EXT4FS=y
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y

# LuCI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-firewall=y

# Block device mounting and filesystem mount-point support.
CONFIG_PACKAGE_block-mount=y

# BTF for dae/daed CO-RE eBPF (built into the kernel; no detached BTF package).
CONFIG_KERNEL_DEBUG_INFO=y
# BTF requires full DWARF type information; reduced debug info disables it.
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
CONFIG_KERNEL_DEBUG_INFO_BTF=y

# dae/daed also requires XDP sockets; BPF syscall/JIT are enabled by x86_64 defaults.
CONFIG_KERNEL_XDP_SOCKETS=y

# turboacc: Full Cone NAT (fw4 compatibility mode) + BBR.
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_FLOW_OFFLOADING=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_BBR_CCA=y
CONFIG_PACKAGE_TURBOACC_INCLUDE_FULLCONE=y
# CONFIG_PACKAGE_TURBOACC_INCLUDE_FAST_CLASSIFIER is not set
# CONFIG_PACKAGE_TURBOACC_INCLUDE_SHORTCUT_FE_CM is not set

# Common virtual NICs and storage controllers for QEMU/KVM.
CONFIG_PACKAGE_kmod-virtio-net=y
CONFIG_PACKAGE_kmod-virtio-blk=y
CONFIG_PACKAGE_kmod-virtio-scsi=y
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-ahci=y
CONFIG_PACKAGE_kmod-ata-core=y

# ---------------------------------------------------------------------
# User-selected applications and utilities (OpenWrt 25.12.6 x86_64)
# Package dependencies are resolved by make defconfig.
# ---------------------------------------------------------------------

# PassWall2 and proxy cores (provided by the pinned PassWall feeds).
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_hysteria=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y

# Docker.
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y

# Cloudflare, DDNS, ACME, FRP and ZeroTier.
CONFIG_PACKAGE_cloudflared=y
CONFIG_PACKAGE_luci-app-cloudflared=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_acme-acmesh=y
CONFIG_PACKAGE_acme-acmesh-dnsapi=y
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_frpc=y
CONFIG_PACKAGE_luci-app-frpc=y
CONFIG_PACKAGE_zerotier=y

# Monitoring.
CONFIG_PACKAGE_netdata=y
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

# Network diagnostics and administration.
CONFIG_PACKAGE_iperf3-ssl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_bind-host=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tc-full=y

# Keep the existing TurboACC/Full Cone/BBR setup and add CAKE.
CONFIG_PACKAGE_kmod-sched-cake=y

# LuCI theme, notifications, Wake-on-LAN, KMS and QEMU guest agent.
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-wechatpush=y
CONFIG_PACKAGE_luci-app-wechatpush_Local_Disk_Information_Detection=y
CONFIG_PACKAGE_luci-app-wechatpush_Host_Information_Detection=y
# CONFIG_PACKAGE_luci-app-wechatpush_Enable_Traffic_Monitoring is not set
CONFIG_PACKAGE_luci-app-wol=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_qemu-ga=y

# Simplified Chinese translations for selected LuCI applications.
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-cloudflared-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-acme-zh-cn=y
CONFIG_PACKAGE_luci-i18n-frpc-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wechatpush-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
# Additional utilities and kernel modules requested after deployment.
CONFIG_PACKAGE_procps-ng-watch=y
CONFIG_PACKAGE_rclone=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_kmod-fuse=y
CONFIG_PACKAGE_kmod-macvlan=y
